SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5433/authserver
DATABASE_USERNAME=authserver
DATABASE_PASSWORD=local-auth-password
AUTH_ISSUER=http://localhost:9000
AUTH_JWK_SET={"keys":[{"kty":"RSA","kid":"replace-with-generated-key"}]}
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
URL_SHORTENER_CLIENT_ID=url-shortener
URL_SHORTENER_CLIENT_SECRET=replace-with-at-least-32-random-bytes
URL_SHORTENER_REDIRECT_URI=http://localhost:8080/login/oauth2/code/auth-server
URL_SHORTENER_POST_LOGOUT_URI=http://localhost:5173/
URL_SHORTENER_AUDIENCE=url-shortener-api
URL_SHORTENER_AUTOMATION_ENABLED=false
URL_SHORTENER_AUTOMATION_CLIENT_ID=url-shortener-automation
URL_SHORTENER_AUTOMATION_CLIENT_SECRET=replace-with-an-independent-random-secret

